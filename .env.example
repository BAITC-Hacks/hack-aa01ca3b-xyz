# Все параметры необязательны: значения по умолчанию подходят для ноутбука с 8+ ГБ памяти.

# Локальная LLM (Ollama слушает только loopback; удалённые адреса приложение отклоняет)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Контекст модели в токенах; для совещаний длиннее 15 минут увеличьте до 16384
OLLAMA_NUM_CTX=8192
# 1 — второй проход агента, который проверяет поручения по транскрипту; 0 — быстрее
AGENT_VERIFY=1

# Распознавание речи: auto — русский → whisper-large-v3-turbo, казахский и шала → whisper-turbo-kaz-rus;
# kz-only — всё через whisper-turbo-kaz-rus (одна модель в памяти). Пусто — auto при ОЗУ ≥ 12 ГБ, иначе kz-only
ASR_ROUTING=
# Порог вероятности русского языка для выбора русской модели
ASR_RU_THRESHOLD=0.8
# cpu / mps / cuda — по умолчанию выбирается автоматически
ASR_DEVICE=
# 1 — выгружать модели распознавания перед запуском LLM (нужно на 8 ГБ ОЗУ)
LOW_MEMORY=1

# Диаризация: sherpa (без токенов, по умолчанию) или pyannote (нужен HF_TOKEN при загрузке)
DIARIZATION_BACKEND=sherpa
# Больше — меньше спикеров; подберите, если два голоса сливаются или один дробится
DIARIZATION_THRESHOLD=0.5
HF_TOKEN=

# Запасной распознаватель faster-whisper (если модели kaz-rus не скачаны)
WHISPER_MODEL=small
